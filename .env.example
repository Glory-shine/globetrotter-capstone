# Copy to .env before running `docker compose up`, or export these directly.
#
# The same JWT secret MUST be shared by user-service, itinerary-service,
# and recommendation-service — it's how tokens minted by user-service are
# verified independently by the other two without a network round-trip.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=gloire
JWT_SECRET_KEY=7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a

# Used to bake the API base URL into the frontend's production build.
# Leave as-is for local Docker Compose use; change if you deploy the
# gateway somewhere other than localhost:8000.
FRONTEND_API_BASE_URL=http://localhost:8000
